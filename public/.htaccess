# Hostinger (Apache / LiteSpeed) ayarları
# Cloudflare Pages kullanılırsa bu dosya yok sayılır; orada _redirects ve _headers geçerlidir.

Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS ve www'ye tek adımda yönlendir
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?biasaglik\.com\.tr$ [NC]
  RewriteRule ^ https://www.biasaglik.com.tr%{REQUEST_URI} [R=301,L,NE]

  # Eski Wix adresleri (Türkçe karakterli) → yeni adresler
  RewriteRule ^lenfödem-tedavi/?$ /lenfodem-tedavi [R=301,L]
  RewriteRule ^kırık-sonrası-tedavi/?$ /kirik-sonrasi-tedavi [R=301,L]
  RewriteRule ^vestibüler-rehabilitasyon/?$ /vestibuler-rehabilitasyon [R=301,L]
  RewriteRule ^kuru-ıgneleme/?$ /kuru-igneleme [R=301,L]

  # /index ve /index.html → /
  RewriteCond %{THE_REQUEST} \s/index(?:\.html)?[\s?]
  RewriteRule ^ / [R=301,L]

  # /sayfa.html → /sayfa (tek adres, tek kanonik)
  RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?]
  RewriteRule ^ /%1 [R=301,L,NE]

  # Sondaki eğik çizgiyi kaldır: /sayfa/ → /sayfa
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /sayfa isteğini sayfa.html dosyasından sun
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # HTML her ziyarette kontrol edilsin (güncelleme anında görünsün)
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>
