---
interface Props { adimlar: { ad: string; url: string }[] }
const { adimlar } = Astro.props;
---
<nav class="kirinti" aria-label="Sayfa yolu">
  <ol class="kap">
    {adimlar.map((a, i) => (
      <li>{i < adimlar.length - 1 ? <a href={a.url}>{a.ad}</a> : <span aria-current="page">{a.ad}</span>}</li>
    ))}
  </ol>
</nav>

<style>
  .kirinti { background: var(--soluk); font-size: .88rem; }
  .kirinti ol { list-style: none; display: flex; flex-wrap: wrap; gap: 4px; padding-block: 10px; margin: 0 auto; }
  .kirinti li:not(:last-child)::after { content: '›'; margin-left: 6px; color: #888; }
  .kirinti a { color: var(--indigo); text-decoration: none; padding: 6px 0; display: inline-block; }
  .kirinti a:hover { text-decoration: underline; }
  .kirinti span { color: #555; padding: 6px 0; display: inline-block; }
</style>
