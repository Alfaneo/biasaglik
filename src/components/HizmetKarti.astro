---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { hizmet: CollectionEntry<'hizmetler'>; baslikEtiketi?: 'h2' | 'h3'; oncelikli?: boolean }
const { hizmet, baslikEtiketi: B = 'h3', oncelikli = false } = Astro.props;
const h = hizmet.data;
---
<a class="hkart" href={`/${hizmet.id}`}>
  <div class="hkart-gorsel">
    <Image src={h.hero} alt={h.heroAlt} width={400} widths={[360, 560, 720]} sizes="(min-width: 1000px) 360px, (min-width: 640px) 45vw, 92vw" loading={oncelikli ? 'eager' : 'lazy'} fetchpriority={oncelikli ? 'high' : undefined} />
    <B class="hkart-baslik">{h.baslik}</B>
  </div>
  <p>{h.kisaAciklama}</p>
</a>

<style>
  .hkart { display: flex; flex-direction: column; background: #fff; border-radius: 8px; overflow: hidden; text-decoration: none; color: #444; box-shadow: var(--golge); height: 100%; transition: transform .15s; }
  .hkart:hover { transform: translateY(-3px); color: #444; }
  .hkart-gorsel { position: relative; aspect-ratio: 16 / 10; }
  .hkart-gorsel img { width: 100%; height: 100%; object-fit: cover; }
  .hkart-baslik { position: absolute; left: 0; right: 0; bottom: 0; margin: 0; padding: 12px 14px; background: rgb(120 120 130 / .72); color: #fff; font-size: 1.15rem; text-align: center; }
  .hkart p { padding: 16px 18px 20px; margin: 0; text-align: center; font-weight: 500; font-size: .95rem; }
</style>
