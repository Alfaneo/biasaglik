---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo.png';
import Ikon from './Ikon.astro';
import { site, menu } from '../data/site';

const yol = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const aktif = (url: string) => (url === '/' ? yol === '/' : yol.startsWith(url));
---
<div class="ustbar">
  <div class="kap ustbar-ic">
    <a href={`mailto:${site.eposta}`} class="ust-eposta"><Ikon ad="eposta" /> <span>{site.eposta}</span></a>
    <a href={site.telefonLink}><Ikon ad="telefon" /> <span>{site.telefon}</span></a>
    <a href={site.whatsapp} rel="noopener" target="_blank"><Ikon ad="whatsapp" /> <span>WhatsApp</span></a>
    <a href="/iletisim" class="ust-ulasin">Bize Ulaşın</a>
  </div>
</div>
<header class="ust">
  <div class="kap ust-ic">
    <a href="/" class="logo" aria-label="Bia Sağlık anasayfa">
      <Image src={logo} alt="Bia Sağlık — Evde Sağlık ve Fizik Tedavi Hizmetleri" width={180} densities={[1, 2]} quality={70} loading="eager" />
    </a>
    <nav class="masaustu-menu" aria-label="Ana menü">
      <ul>
        {menu.map((m) => <li><a href={m.url} aria-current={aktif(m.url) ? 'page' : undefined}>{m.ad}</a></li>)}
      </ul>
    </nav>
    <details class="mobil-menu">
      <summary aria-label="Menüyü aç"><Ikon ad="menu" boyut={28} /></summary>
      <nav aria-label="Mobil menü">
        <ul>
          {menu.map((m) => <li><a href={m.url} aria-current={aktif(m.url) ? 'page' : undefined}>{m.ad}</a></li>)}
        </ul>
      </nav>
    </details>
    <a href="/iletisim#randevu" class="btn btn-mavi ust-cta">Ücretsiz İlk Muayene!</a>
  </div>
</header>

<style>
  .ustbar { background: var(--lacivert); color: #fff; font-size: .9rem; }
  .ustbar-ic { display: flex; gap: 28px; align-items: center; min-height: 40px; }
  .ustbar a { color: #fff; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; min-height: 40px; }
  .ustbar a:hover { color: var(--turkuaz); }
  .ust-ulasin { margin-left: auto; }
  .ust { background: #fff; border-bottom: 1px solid var(--cizgi); position: relative; z-index: 20; }
  .ust-ic { display: flex; align-items: center; gap: 24px; min-height: 76px; }
  .logo img { width: 180px; height: auto; }
  .ust-cta { margin-left: auto; min-height: 42px; padding: 8px 20px; font-size: .95rem; border-radius: 4px; }
  .mobil-menu { margin-left: auto; }
  .mobil-menu summary { list-style: none; cursor: pointer; color: var(--lacivert); display: flex; padding: 10px; }
  .mobil-menu summary::-webkit-details-marker { display: none; }
  .ust ul { list-style: none; margin: 0; padding: 0; }
  .ust nav a { color: #222; text-decoration: none; font-size: .95rem; }
  .ust nav a:hover, .ust nav a[aria-current] { color: var(--indigo); }

  @media (max-width: 899px) {
    .ustbar .ust-eposta, .ustbar .ust-ulasin, .ust .ust-cta, .masaustu-menu { display: none; }
    .ustbar-ic { justify-content: center; gap: 20px; }
    .logo img { width: 150px; }
    .mobil-menu nav { position: absolute; left: 0; right: 0; top: 100%; background: #fff; box-shadow: var(--golge); padding: 8px 20px 16px; }
    .mobil-menu li a { display: block; padding: 12px 0; border-bottom: 1px solid var(--cizgi); font-size: 1.05rem; }
  }
  @media (min-width: 900px) {
    .mobil-menu { display: none; }
    .masaustu-menu { margin-left: 40px; }
    .masaustu-menu ul { display: flex; gap: 38px; }
  }
</style>
