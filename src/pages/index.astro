---
import { Image } from 'astro:assets';
import HeroGorsel from '../components/HeroGorsel.astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HizmetKarti from '../components/HizmetKarti.astro';
import IletisimBolumu from '../components/IletisimBolumu.astro';
import Sss from '../components/Sss.astro';
import hero from '../assets/img/anasayfa-hero.jpg';
import heroMobil from '../assets/img/anasayfa-hero-mobil.jpg';
import hero2 from '../assets/img/anasayfa-hero-2.jpg';
import hero2Mobil from '../assets/img/anasayfa-hero-2-mobil.jpg';
import dokuLacivert from '../assets/img/doku-lacivert.jpg';
import dokuTurkuaz from '../assets/img/doku-turkuaz.jpg';
import { site, tecrubeYili, kategoriSirasi, kategoriBaslik } from '../data/site';
import { isletmeSchema, sssSchema } from '../data/schema';

const hizmetler = await getCollection('hizmetler');
const oneCikan = ['norolojik-rehabilitasyon', 'pediatrik-rehabilitasyon', 'ortopedik-rehabilitasyon', 'pulmoner-rehabilitasyon', 'skolyoz-tedavisi', 'kuru-igneleme']
  .map((id) => hizmetler.find((h) => h.id === id)!)
  .filter(Boolean);
const kategoriler = kategoriSirasi.map((k) => ({
  ad: kategoriBaslik[k],
  liste: hizmetler.filter((h) => h.data.kategori === k).sort((a, b) => a.data.baslik.localeCompare(b.data.baslik, 'tr')),
}));
const uzmanlar = (await getCollection('uzmanlar')).sort((a, b) => a.data.sira - b.data.sira);

const nedenler = [
  { baslik: 'Deneyim', metin: `Bia Sağlık, ${site.kurulusYili} yılından bu yana evde fizik tedavi alanında hizmet veriyor. Alanında uzman kadrosuyla hastalarına kaliteli hizmet sunar.` },
  { baslik: 'Konfor', metin: 'Tedavi kendi evinizde yapılır. Yol, trafik ve bekleme salonu yoktur; iyileşme sürecinizi evinizin rahatlığında sürdürürsünüz.' },
  { baslik: 'Erişim kolaylığı', metin: "İstanbul'un her noktasına geniş hizmet ağı ve mobil ekibimizle ulaşıyoruz. Bulunduğunuz bölgede zaman kaybetmeden tedaviye başlarsınız." },
  { baslik: 'Kişiselleştirilmiş program', metin: 'Uzman fizyoterapistlerimizin hazırladığı size özel rehabilitasyon programlarıyla, ihtiyacınıza uygun bir tedavi planı uygulanır.' },
];

const yorumlar = [
  { metin: 'Hizmetleri ve cihazları çok iyi ve profesyonel. Kolumda uyuşma vardı, parmaklarıma kadar hissediyordum. Boyun fıtığı teşhisiyle başvurdum. 8 günde iyileştim, teşekkür ederim Esma hoca.', ad: 'Yağmur Kaplan' },
  { metin: 'Röntgen sonucu gördüğüm kamburluktan (kifoz) şikâyetçiydim. Hocalarım sağ olsun çok yardımcı oldular. Emeklerine sağlık.', ad: 'Barkın Bozkurt' },
  { metin: "Tibia plato üst uç kırığı yaşadım, İrfan hocamla fizik tedaviye başladık. İrfan hocamın tedavisi çok iyi geldi. Bia Sağlık'a ve İrfan hocama çok teşekkür ederim. Herkese tavsiye ederim.", ad: 'Nezat Susmuş' },
];

const sss = [
  { soru: 'Evde fizik tedavi nasıl işler?', cevap: 'Bizi aradığınızda fizyoterapistimiz evinize gelir ve ücretsiz ilk değerlendirmeyi yapar. Şikâyetinize ve hedeflerinize göre size özel bir program hazırlanır; seanslar gerekli ekipmanlarla kendi evinizde uygulanır ve ilerlemeniz düzenli olarak takip edilir.' },
  { soru: "İstanbul'un hangi bölgelerine hizmet veriyorsunuz?", cevap: "Geniş hizmet ağımız ve mobil ekibimizle İstanbul'un her noktasına ulaşıyoruz. Bulunduğunuz bölge için uygun gün ve saati telefonla ya da WhatsApp üzerinden birlikte planlarız." },
  { soru: 'İlk muayene ücretli mi?', cevap: 'Hayır. İlk değerlendirme ücretsizdir. Bu görüşmede fizyoterapistimiz durumunuzu inceler, evde fizik tedavinin size uygun olup olmadığını ve kaç seans gerekebileceğini söyler.' },
  { soru: 'Hangi durumlarda evde fizik tedavi tercih edilir?', cevap: 'İnme (felç) sonrası, ameliyat veya kırık sonrası, yoğun bakım sonrası, ileri yaş, kronik ağrı, nörolojik hastalıklar ve çocuk rehabilitasyonu gibi dışarı çıkmanın zor olduğu ya da evde tedavinin daha konforlu olacağı her durumda tercih edilir.' },
  { soru: 'Çalışma saatleriniz nedir?', cevap: `${site.calismaSaatleri} saatleri arasında hizmet veriyoruz. Pazar günleri kapalıyız.` },
];

const schema = [
  isletmeSchema(),
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.ad, url: site.url, inLanguage: 'tr-TR' },
  sssSchema(sss),
];
---
<Base
  baslik="Evde Fizik Tedavi İstanbul | Bia Sağlık"
  aciklama={`İstanbul'da evde fizik tedavi ve rehabilitasyon. ${site.kurulusYili}'dan beri uzman fizyoterapistlerle evinizde tedavi. Ücretsiz ilk muayene için arayın.`}
  schema={schema}
>
  <section class="hero" id="hero" aria-roledescription="carousel" aria-label="Öne çıkanlar" data-aktif="0">
    <div class="hero-arka">
      <HeroGorsel masaustu={hero} mobil={heroMobil} alt="Fizyoterapist, evinde yaşlı bir hastaya dambılla egzersiz yaptırıyor" oncelikli class="hero-gorsel" />
      <!-- 2. slaytın görseli sayfa yüklendikten sonra eklenir; açılış hızını etkilemez -->
      <template id="hero-2-gorsel">
        <HeroGorsel masaustu={hero2} mobil={hero2Mobil} alt="Fizyoterapist, yaşlı bir hastanın elini şefkatle tutuyor" class="hero-gorsel" />
      </template>
    </div>
    <div class="hero-slaytlar">
      <div class="hero-ic" role="group" aria-roledescription="slide" aria-label="1 / 2">
        <h1 class="hero-baslik">Evde Fizik Tedavi</h1>
        <div class="hero-serit" aria-hidden="true"><span></span><span></span><span></span></div>
        <p class="hero-metin">Bia Sağlık olarak, evde fizik tedavi hizmetiyle sağlığınıza evinizin konforunda kavuşmanızı sağlıyoruz. Uzman ekibimiz, sizin için özel olarak tasarlanmış tedavi planlarıyla, iyileşme sürecinizi destekliyor ve size en iyi sonuçları sunuyor.</p>
      </div>
      <div class="hero-ic hero-ic-2" role="group" aria-roledescription="slide" aria-label="2 / 2" aria-hidden="true">
        <p class="hero-baslik">Evde Fizyoterapi ile Daha İyi Bir Yaşam</p>
        <div class="hero-serit" aria-hidden="true"><span></span><span></span><span></span></div>
        <p class="hero-metin">Bia Sağlık'ta kişiselleştirilmiş tedavilerimiz ve uzman fizyoterapist kadromuzla size en uygun tedavi yöntemlerini sunuyor, sağlığınızı güvence altına alıyoruz.</p>
      </div>
    </div>
    <button class="hero-ok hero-geri" type="button" aria-label="Önceki slayt" hidden><svg viewBox="0 0 21 41" aria-hidden="true"><path d="M20.3 40.8 0 20.5 20.3.2l.7.7L1.3 20.5 21 40.1z"/></svg></button>
    <button class="hero-ok hero-ileri" type="button" aria-label="Sonraki slayt" hidden><svg viewBox="0 0 21 41" aria-hidden="true"><path d="M.7 40.8 21 20.5.7.2 0 .9l19.7 19.6L0 40.1z"/></svg></button>
    <ul class="hero-kutular">
      <li><span>Uzman</span> <strong>Terapistler</strong></li>
      <li><span>Kişiselleştirilmiş</span> <strong>Programlar</strong></li>
      <li><span>Evde</span> <strong>Fizik Tedavi</strong></li>
    </ul>
  </section>
  <script is:inline>
    (function () {
      var h = document.getElementById('hero'); if (!h) return;
      var slaytlar = h.querySelectorAll('.hero-ic'), n = slaytlar.length, i = 0, zaman;
      var sakin = matchMedia('(prefers-reduced-motion: reduce)').matches;
      function goster(k) {
        i = (k + n) % n; h.setAttribute('data-aktif', i);
        slaytlar.forEach(function (s, j) {
          s.setAttribute('aria-hidden', j !== i);
          s.querySelectorAll('a').forEach(function (a) { a.tabIndex = j === i ? 0 : -1; });
        });
      }
      function baslat() { if (!sakin) { clearInterval(zaman); zaman = setInterval(function () { goster(i + 1); }, 6000); } }
      function hazirla() {
        var t = document.getElementById('hero-2-gorsel');
        h.querySelector('.hero-arka').appendChild(t.content.cloneNode(true));
        h.querySelectorAll('.hero-ok').forEach(function (b) { b.hidden = false; });
        h.querySelector('.hero-geri').onclick = function () { goster(i - 1); baslat(); };
        h.querySelector('.hero-ileri').onclick = function () { goster(i + 1); baslat(); };
        h.addEventListener('mouseenter', function () { clearInterval(zaman); });
        h.addEventListener('mouseleave', baslat);
        h.addEventListener('focusin', function () { clearInterval(zaman); });
        baslat();
      }
      if (document.readyState === 'complete') setTimeout(hazirla, 1200);
      else addEventListener('load', function () { setTimeout(hazirla, 1200); });
    })();
  </script>

  <section class="bolum">
    <div class="kap dar ortala">
      <h2 class="baslik-kare">Hakkımızda</h2>
      <p class="hakkinda-metin">Bia Sağlık, {site.kurulusYili}'dan beri evde fizik tedavi hizmeti veriyor. Misyonumuz, hastalarımızın konforunu ve iyileşme süreçlerini ön planda tutarak evlerinde en etkili tedaviyi almalarını sağlamak. İstanbul'un her noktasına geniş hizmet ağımız ve mobil ekibimizle ulaşıyoruz. Amacımız, hastalarımızın sağlık sorunlarıyla mücadele ederken aileleriyle birlikte, konforlu bir ortamda tedavi almalarını sağlamak.</p>
      <a href="/hakkimizda" class="btn btn-turkuaz">Daha fazlası için</a>
    </div>
  </section>

  <section class="bolum hizmetler" id="hizmetlerimiz">
    <Image src={dokuLacivert} alt="" width={1440} widths={[720, 1440]} sizes="100vw" quality={35} loading="lazy" class="arka" />
    <div class="kap on">
      <h2 class="baslik-kare beyaz">Hizmetlerimiz</h2>
      <div class="izgara">
        {oneCikan.map((h) => <HizmetKarti hizmet={h} />)}
      </div>
      <div class="tum-hizmetler">
        {kategoriler.map((k) => (
          <div>
            <h3>{k.ad}</h3>
            <ul>{k.liste.map((h) => <li><a href={`/${h.id}`}>{h.data.baslik}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sayilar" aria-label="Rakamlarla Bia Sağlık">
    <ul class="kap">
      <li><strong>{tecrubeYili}</strong><span>Yıllık tecrübe</span></li>
      <li><strong>1500+</strong><span>Mutlu hasta</span></li>
      <li><strong>18+</strong><span>Sertifika</span></li>
      <li><strong>6</strong><span>Uzman terapist</span></li>
    </ul>
  </section>

  <section class="bolum neden">
    <Image src={dokuTurkuaz} alt="" width={1440} widths={[720, 1440]} sizes="100vw" quality={35} loading="lazy" class="arka" />
    <div class="kap on">
      <h2 class="baslik-kare beyaz">Neden Bia Sağlık?</h2>
      <ul class="neden-liste">
        {nedenler.map((n) => <li><h3>{n.baslik}</h3><p>{n.metin}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="bolum">
    <div class="kap">
      <h2 class="baslik-kare">Uzmanlarımız</h2>
      <ul class="uzmanlar">
        {uzmanlar.map((u) => (
          <li>
            <Image src={u.data.foto} alt={`${u.data.ad}, ${u.data.unvan}`} width={220} densities={[1, 2]} loading="lazy" />
            <h3>{u.data.ad}</h3>
            <p>{u.data.unvan}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bolum yorumlar">
    <div class="kap">
      <h2 class="baslik-kare beyaz">Mutlu Misafirlerimiz</h2>
      <ul>
        {yorumlar.map((y) => (
          <li><blockquote><p>{y.metin}</p></blockquote><p class="yorum-ad">{y.ad}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <Sss sss={sss} baslik="Evde fizik tedavi hakkında sık sorulanlar" />

  <IletisimBolumu />
</Base>

<style>
  /* ---- Hero: Wix ölçüleriyle birebir (masaüstü 980px içerik, 1015px yükseklik) ---- */
  .hero { position: relative; background: #273272; color: #fff; overflow: hidden; min-height: 1015px; }
  .hero-arka { position: absolute; inset: 0; }
  .hero-arka :global(picture) { position: absolute; inset: 0; transition: opacity .9s ease; }
  .hero-arka :global(.hero-gorsel) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; opacity: .43; }
  .hero-arka :global(picture:nth-of-type(2)) { opacity: 0; }
  .hero[data-aktif="1"] .hero-arka :global(picture:nth-of-type(1)) { opacity: 0; }
  .hero[data-aktif="1"] .hero-arka :global(picture:nth-of-type(2)) { opacity: 1; }
  .hero-slaytlar { position: relative; z-index: 2; display: grid; width: min(980px, 100% - 40px); margin: 0 auto; }
  .hero-ic { grid-area: 1 / 1; padding-top: 171px; transition: opacity .6s ease, visibility .6s; }
  .hero-ic-2 { opacity: 0; visibility: hidden; }
  .hero[data-aktif="1"] .hero-ic:not(.hero-ic-2) { opacity: 0; visibility: hidden; }
  .hero[data-aktif="1"] .hero-ic-2 { opacity: 1; visibility: visible; }
  .hero-baslik { font: 700 55px/73px var(--baslik-font); letter-spacing: .05em; color: #fff; margin: 0; }
  .hero-ic-2 .hero-baslik { text-transform: uppercase; max-width: 720px; }
  .hero-serit { display: flex; margin: 13px 0 21px; }
  .hero-serit span { display: block; width: 156px; height: 13px; }
  .hero-serit span:nth-child(1) { background: #404040; margin-right: 3px; }
  .hero-serit span:nth-child(2) { background: #1990ce; }
  .hero-serit span:nth-child(3) { background: #515dac; }
  .hero-metin { font: 400 24px/33.6px RobotoWeb, var(--govde-font); max-width: 684px; margin: 0; color: #fff; }
  .hero-ic-2 .hero-metin { max-width: 604px; }
  .hero-ok { position: absolute; z-index: 3; top: 50%; transform: translateY(-50%); width: 45px; height: 72px; display: grid; place-items: center; background: none; border: 0; cursor: pointer; color: #fff; }
  .hero-ok[hidden] { display: none; }
  .hero-ok:hover, .hero-ok:focus-visible { opacity: .75; }
  .hero-ok svg { width: 25px; height: 52px; fill: currentColor; }
  .hero-geri { left: 90px; }
  .hero-ileri { right: 90px; }
  .hero-kutular { position: absolute; z-index: 2; left: 50%; bottom: 0; transform: translateX(-50%); width: min(980px, 100% - 40px); list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); }
  .hero-kutular li { height: 280px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; border-bottom: 8px solid; font: 400 30px/40px var(--baslik-font); letter-spacing: 1.5px; text-transform: uppercase; }
  .hero-kutular strong { font-weight: 700; }
  .hero-kutular li:nth-child(1) { background: rgb(81 93 172 / .72); border-color: #515dac; }
  .hero-kutular li:nth-child(2) { background: rgb(25 144 206 / .62); border-color: #1990ce; }
  .hero-kutular li:nth-child(3) { background: rgb(39 50 114 / .72); border-color: #273272; }
  @media (max-width: 1180px) { .hero-geri { left: 16px; } .hero-ileri { right: 16px; } }
  @media (max-width: 979px) {
    .hero-kutular li { font-size: clamp(18px, 3vw, 30px); line-height: 1.35; }
    .hero-baslik { font-size: clamp(36px, 5.6vw, 55px); line-height: 1.33; }
  }
  /* Mobil: Wix'in 320px mobil düzeni ekran genişliğine göre ölçeklenir (1u = 100vw/320) */
  @media (max-width: 699px) {
    .hero { --u: calc(100vw / 320); min-height: calc(var(--u) * 664); }
    .hero-slaytlar { width: auto; margin: 0 calc(var(--u) * 20); }
    .hero-ic { padding-top: calc(var(--u) * 47); }
    .hero-baslik { font-size: calc(var(--u) * 21); line-height: 1.35; letter-spacing: .05em; }
    .hero-ic-2 .hero-baslik { max-width: none; }
    .hero-serit { display: none; }
    .hero-metin { font-family: var(--govde-font); font-size: calc(var(--u) * 16); line-height: calc(var(--u) * 22.4); max-width: none; margin-top: calc(var(--u) * 24); }
    .hero-ok { display: none; }
    .hero-kutular { left: calc(var(--u) * 20); right: calc(var(--u) * 20); top: calc(var(--u) * 319); bottom: auto; transform: none; width: auto; grid-template-columns: 1fr; gap: calc(var(--u) * 21); }
    .hero-kutular li { height: calc(var(--u) * 98); border-bottom-width: calc(var(--u) * 10); font-size: calc(var(--u) * 20); line-height: 1.3; letter-spacing: calc(var(--u) * 1); }
  }

  .hakkinda-metin { text-align: left; margin: 28px 0; }

  .arka { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .on { position: relative; }
  .hizmetler { position: relative; background: #0d2466; overflow: hidden; }
  .hizmetler h2 { margin-bottom: 40px; }
  .tum-hizmetler { margin-top: 44px; display: grid; gap: 22px 32px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr)); color: #fff; }
  .tum-hizmetler h3 { color: var(--turkuaz); font-size: 1.05rem; margin-bottom: 8px; }
  .tum-hizmetler ul { list-style: none; margin: 0; padding: 0; }
  .tum-hizmetler a { color: #fff; text-decoration: none; display: inline-block; padding: 5px 0; font-size: .95rem; }
  .tum-hizmetler a:hover { color: var(--turkuaz); text-decoration: underline; }

  .sayilar ul { list-style: none; margin: 0 auto; padding-block: 34px; display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; gap: 12px; }
  .sayilar strong { display: block; font: 700 clamp(2rem, 6vw, 3.2rem)/1.1 var(--baslik-font); color: var(--lacivert); }
  .sayilar span { font-size: clamp(.8rem, 2vw, .95rem); color: #222; }

  .neden { position: relative; background: #0d5a78; color: #fff; overflow: hidden; }
  .neden::before { content: ''; position: absolute; inset: 0; background: rgb(8 72 100 / .55); z-index: 1; }
  .neden .on { z-index: 2; }
  .neden-liste { list-style: none; padding: 0; margin: 40px 0 0; display: grid; gap: 34px 40px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); text-align: center; }
  .neden h3 { color: #fff; font-size: 1.35rem; }
  .neden-liste p { margin: 0; opacity: .95; }

  .uzmanlar { list-style: none; padding: 0; margin: 40px 0 0; display: grid; gap: 36px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); text-align: center; }
  .uzmanlar img { width: 180px; height: 180px; object-fit: cover; border-radius: 50%; margin: 0 auto 14px; object-position: top; }
  .uzmanlar h3 { color: var(--indigo); font-size: 1.5rem; margin-bottom: 2px; }
  .uzmanlar p { font: 700 1rem var(--baslik-font); color: #222; margin: 0; }

  .yorumlar { background: var(--lacivert); color: #fff; }
  .yorumlar ul { list-style: none; padding: 0; margin: 40px 0 0; display: grid; gap: 34px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); text-align: center; }
  .yorumlar blockquote { margin: 0; }
  .yorumlar blockquote::before { content: '”'; display: block; font: 700 4rem/0.9 var(--baslik-font); color: var(--mint); height: 40px; }
  .yorumlar blockquote p { font-style: italic; font-size: .96rem; }
  .yorum-ad { font-size: .88rem; opacity: .8; }

  @media (max-width: 599px) {
    .sayilar ul { grid-template-columns: repeat(2, 1fr); row-gap: 22px; }
  }
</style>
